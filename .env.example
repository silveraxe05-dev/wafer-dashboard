# Wafer-track API that reads ADF-landed Synapse tables
# (dim_wafer, fact_wafer_movement, fact_die_test_result, dim_location)
#
# Local split: http://localhost:8787
# Single-host / Docker: leave empty so the UI calls /wafer-track/bundle on the same origin
VITE_ADF_API_BASE=http://localhost:8787

# Optional API process overrides
# ADF_API_PORT=8787
# PORT=8080
# SERVE_UI=1
# CORS_ORIGIN=https://your-ui.example.com
# ADF_SQLITE_PATH=./data/fabops.sqlite
